#include <p16f887.inc>

    __CONFIG _CONFIG1, _XT_OSC & _WDT_OFF & _PWRTE_ON & _MCLRE_ON & _CP_OFF & _CPD_OFF & _BOREN_OFF & _IESO_OFF & _FCMEN_OFF & _LVP_OFF
    __CONFIG _CONFIG2, _BOR40V & _WRT_OFF
    
    LIST p=16F887 

    ;CBLOCK 0X20
    TECLA       EQU 0x20
    BB          EQU 0x21
    TIEMPO0     EQU 0x22
    TIEMPO1     EQU 0x23
    TIEMPO2     EQU 0x24
    ;ENDC
    ;CBLOCK 0X70
    W_TEMP      EQU 0x70 
    STATUS_TEMP EQU 0x71 
    ;ENDC
  
    ORG 0x00 
    GOTO INICIO 

    ORG 0x04
    MOVWF W_TEMP  ;SALVAR CONTEXTO
    SWAPF STATUS,W 
    MOVWF STATUS_TEMP 

    BTFSS INTCON,RBIF      
    GOTO SALIR
    BSF BB,0         
    
    MOVF PORTB,W           
    BCF INTCON,RBIF        

SALIR
    SWAPF STATUS_TEMP,W ;RECUPERAR CONTEXTO
    MOVWF STATUS
    SWAPF W_TEMP,F
    SWAPF W_TEMP,W
    RETFIE               ;RETORNO Y HABILITO INTERR                        

    ORG 0x30            
INICIO
    BANKSEL ANSEL    
    CLRF ANSEL          
    CLRF ANSELH         
     
    BANKSEL TRISD    
    CLRF TRISD          
    
    MOVLW B'11110000'   
    MOVWF TRISB         
    MOVLW B'11110000'   
    MOVWF WPUB ;PULL UP
    
    MOVLW B'11110000'   
    MOVWF IOCB ;INTERR EN PB, MIRAR ENTRADAS

    MOVLW B'01010101'   
    MOVWF OPTION_REG
     
    BANKSEL PORTD    
    CLRF PORTD          
    CLRF BB       

    MOVLW B'00000000'   
    MOVWF PORTB         
    
    MOVF PORTB,W
    BCF INTCON,RBIF

    MOVLW B'10001000'   ;INTERRUP GLOBAL Y POR PURTO B
    MOVWF INTCON

MAIN 
    BTFSS BB,0
    GOTO MAIN           
     
    BCF BB,0     
    
    CALL RETARDO        
    
    CALL LEER_TECLADO   
    MOVWF TECLA        
     
    MOVLW .10         
    XORWF TECLA,W
    BTFSC STATUS,Z
    GOTO REINICIO  
     
    MOVF TECLA,W
    CALL TABLA_DISPLAY
    MOVWF PORTD           
     
REINICIO
    MOVLW B'00000000'
    MOVWF PORTB
    
    CALL RETARDO        
    
    MOVF PORTB,W
    BCF INTCON,RBIF
    
    GOTO MAIN          

RETARDO
     MOVLW D'6'          
     MOVWF TIEMPO2 
BUCLE_EXTERNO      
     MOVLW D'111'        
     MOVWF TIEMPO1  
BUCLE_MEDIO    
     MOVLW D'250'        
     MOVWF TIEMPO0
BUCLE_INTERNO
     DECFSZ TIEMPO0,F   
     GOTO BUCLE_INTERNO 
     DECFSZ TIEMPO1, F  
     GOTO BUCLE_MEDIO 
     DECFSZ TIEMPO2, F  
     GOTO BUCLE_EXTERNO
     RETURN 

LEER_TECLADO
    MOVLW B'00001111'
    MOVWF PORTB         

    BCF PORTB,0        
    NOP
    BTFSS PORTB,4      
    RETLW .1            
    BTFSS PORTB,5      
    RETLW .2            
    BTFSS PORTB,6      
    RETLW .3            
    BSF PORTB,0        

    BCF PORTB,1        
    NOP
    BTFSS PORTB,4      
    RETLW .4            
    BTFSS PORTB,5      
    RETLW .5            
    BTFSS PORTB,6      
    RETLW .6            
    BSF PORTB,1        

    BCF PORTB,2        
    NOP
    BTFSS PORTB,4      
    RETLW .7            
    BTFSS PORTB,5      
    RETLW .8            
    BTFSS PORTB,6      
    RETLW .9            
    BSF PORTB,2        

    BCF PORTB,3        
    NOP
    BTFSS PORTB,5      
    RETLW .0            
    BSF PORTB,3        

    RETLW .10          

TABLA_DISPLAY 
     ADDWF PCL, F         
     RETLW B'00111111'  
     RETLW B'00000110'  
     RETLW B'01011011'  
     RETLW B'01001111'  
     RETLW B'01100110'  
     RETLW B'01101101'  
     RETLW B'01111101'  
     RETLW B'00000111'  
     RETLW B'01111111'  
     RETLW B'01101111'  

     END
